*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.txt text eol=lf

# Preserve local dataset bytes because manifests record file checksums.
data/** -text
data/README.md text eol=lf

# Explicitly approved trained model exports use Git LFS.
artifacts/models/**/*.pt filter=lfs diff=lfs merge=lfs -text
artifacts/models/**/*.pkl filter=lfs diff=lfs merge=lfs -text
